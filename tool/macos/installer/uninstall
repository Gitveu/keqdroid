#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
runtime='/Library/Application Support/com.keqdroid.keqdroid'
daemon='/Library/LaunchDaemons/com.keqdroid.keqdroid.network-service.plist'
app='/Applications/keqdroid.app'
fail() { echo "keqdroid: $*" >&2; exit 1; }
[[ $(id -u) == 0 && "${3:-/}" == / ]] || fail 'Uninstall as administrator on the current startup disk only.'
for location in "$runtime" "$app" "$daemon"; do
  [[ ! -L "$location" ]] || { echo "Refusing symbolic link: $location" >&2; exit 1; }
done
if pgrep -x keqdroid >/dev/null; then echo 'Quit keqdroid before uninstalling.' >&2; exit 1; fi
[[ ! -e "$runtime" || -d "$runtime" ]] || fail 'The runtime destination is not a directory.'
if [[ ! -d "$runtime" ]] && launchctl print system/com.keqdroid.keqdroid.network-service >/dev/null 2>&1; then
  fail 'Restore the recovery service with its installer before uninstalling.'
fi
if [[ -e "$app" ]]; then
  [[ -d "$app" ]] || fail 'The application destination is not a directory.'
  [[ $(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist") == com.keqdroid.keqdroid ]] || fail 'Another application occupies the installation path.'
fi
service_loaded=0
restored=0
restart_on_failure() {
  local result=$?
  trap - EXIT
  if [[ $result != 0 && $service_loaded == 1 && $restored == 0 ]]; then
    launchctl bootstrap system "$daemon" || echo 'keqdroid: restarting the preserved service needs repair.' >&2
  fi
  exit "$result"
}
if [[ -d "$runtime" ]]; then
  [[ $(stat -f %u "$runtime") == 0 ]] || fail 'The installed runtime is not owned by root.'
  [[ -x "$runtime/bin/keqdroid-network-service" && ! -L "$runtime/bin/keqdroid-network-service" ]] || fail 'The recovery service is missing.'
  if launchctl print system/com.keqdroid.keqdroid.network-service >/dev/null 2>&1; then
    service_loaded=1
    trap restart_on_failure EXIT
    launchctl bootout system/com.keqdroid.keqdroid.network-service
  fi
  "$runtime/bin/keqdroid-network-service" --recover
  restored=1
  rm -rf "$runtime"
fi
rm -f "$daemon"
if [[ -d "$app" ]]; then
  rm -rf "$app"
fi
# Remove only this product's login item, never application preferences or subscriptions.
for user_home in /Users/*; do
  login_item="$user_home/Library/LaunchAgents/com.keqdroid.keqdroid.login.plist"
  [[ -f "$login_item" && ! -L "$login_item" ]] || continue
  [[ $(/usr/libexec/PlistBuddy -c 'Print :Label' "$login_item") == com.keqdroid.keqdroid.login ]] || continue
  owner_uid=$(stat -f %u "$login_item")
  launchctl bootout "gui/$owner_uid/com.keqdroid.keqdroid.login" >/dev/null 2>&1 || true
  rm -f "$login_item"
done
/usr/sbin/pkgutil --forget com.keqdroid.keqdroid.installer >/dev/null 2>&1 || true
exit 0
