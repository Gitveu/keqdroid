+// before a TCP handshake, see tool/patches/xray-owner-guard.patch.
+func (r *Router) MatchRuleTag(ctx routing.Context, tag string) bool {
+	for _, rule := range *r.rules.Load() {
+		if rule.RuleTag == tag {
+			return rule.Apply(ctx)
+		}
+	}
+	return false
+}
