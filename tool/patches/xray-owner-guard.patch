+package router_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/golang/mock/gomock"
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+	"github.com/xtls/xray-core/testing/mocks"
+)
+
+// keqdroid: the tun asks only the tagged rule before a handshake, so a rule
+// above it must not decide, see tool/patches/xray-owner-guard.patch.
+func TestMatchRuleTagAppliesOnlyThatRule(t *testing.T) {
+	config := &Config{
+		Rule: []*RoutingRule{
+			{
+				TargetTag: &RoutingRule_Tag{Tag: "direct"},
+				RuleTag:   "udp-first",
+				Networks:  []net.Network{net.Network_UDP},
+			},
+			{
+				TargetTag: &RoutingRule_Tag{Tag: "block"},
+				RuleTag:   "outside-vpn",
+				Networks:  []net.Network{net.Network_TCP},
+			},
+		},
+	}
+
+	mockCtl := gomock.NewController(t)
+	defer mockCtl.Finish()
+
+	r := new(Router)
+	common.Must(r.Init(context.TODO(), config, mocks.NewDNSClient(mockCtl), nil, nil))
+
+	routingCtx := func(dest net.Destination) *routing_session.Context {
+		ctx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: dest}})
+		return routing_session.AsRoutingContext(ctx).(*routing_session.Context)
+	}
+	tcp := routingCtx(net.TCPDestination(net.ParseAddress("1.1.1.1"), 443))
+	udp := routingCtx(net.UDPDestination(net.ParseAddress("1.1.1.1"), 443))
+
+	if !r.MatchRuleTag(tcp, "outside-vpn") {
+		t.Error("tcp should match the outside-vpn rule")
+	}
+	if r.MatchRuleTag(udp, "outside-vpn") {
+		t.Error("udp matches only the rule above, not outside-vpn")
+	}
+	if r.MatchRuleTag(tcp, "udp-first") {
+		t.Error("udp-first must not match tcp")
+	}
+	if r.MatchRuleTag(tcp, "missing") {
+		t.Error("a tag with no rule matches nothing")
+	}
+}
diff --git a/proxy/tun/owner_guard_android.go b/proxy/tun/owner_guard_android.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/owner_guard_android.go
@@ -0,0 +1,33 @@
+//go:build android
+
+package tun
+
+import (
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+// keqdroid, see tool/patches/xray-owner-guard.patch: the rule keqdroid writes
+// first when it protects the server address from apps outside the VPN.
+const outsideVPNRuleTag = "outside-vpn"
+
+type ruleTagMatcher interface {
+	MatchRuleTag(ctx routing.Context, tag string) bool
+}
+
+// rejectBeforeHandshake answers before the stack completes a TCP handshake:
+// an app outside the VPN gets a reset, not a connection that opens and dies.
+func (t *Handler) rejectBeforeHandshake(src, dst net.Destination) bool {
+	if t.instance == nil {
+		return false
+	}
+	matcher, ok := t.instance.GetFeature(routing.RouterType()).(ruleTagMatcher)
+	if !ok {
+		return false
+	}
+	ctx := session.ContextWithInbound(t.ctx, &session.Inbound{Source: src, Tag: t.tag})
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dst, OriginalTarget: dst}})
+	return matcher.MatchRuleTag(routing_session.AsRoutingContext(ctx), outsideVPNRuleTag)
+}
