diff --git a/proxy/tun/icmp_direct_test.go b/proxy/tun/icmp_direct_test.go
new file mode 100644
index 0000000..951f6b7
--- /dev/null
+++ b/proxy/tun/icmp_direct_test.go
@@ -0,0 +1,117 @@
+//go:build windows || (linux && !android)
+
+package tun
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+var (
+	icmpClient = tcpip.AddrFrom4([4]byte{172, 19, 0, 1})
+	icmpTarget = netip.MustParseAddr("1.1.1.1")
+	icmpRouter = netip.MustParseAddr("10.0.0.1")
+)
+
+func echoMessage(typ byte, ident, seq uint16, payload string) []byte {
+	m := make([]byte, 8+len(payload))
+	m[0] = typ
+	binary.BigEndian.PutUint16(m[4:6], ident)
+	binary.BigEndian.PutUint16(m[6:8], seq)
+	copy(m[8:], payload)
+	binary.BigEndian.PutUint16(m[2:4], ^checksum.Checksum(m, 0))
+	return m
+}
+
+func validV4Checksum(m []byte) bool {
+	return checksum.Checksum(m, 0) == 0xffff
+}
+
+func newTestDirect() *icmpDirect {
+	d := newICMPDirect(nil)
+	d.pending[icmpPendingKey{dst: icmpTarget, ident: 7, seq: 3}] = icmpPending{
+		src:      icmpClient,
+		ident:    0x1234,
+		checksum: 0xbeef,
+		at:       time.Now(),
+	}
+	return d
+}
+
+func TestICMPDirectEchoReplyGetsClientIdentBack(t *testing.T) {
+	d := newTestDirect()
+	out, src, dst, ok := d.translate(false, echoMessage(byte(header.ICMPv4EchoReply), 7, 3, "abc"), icmpTarget)
+	if !ok {
+		t.Fatal("reply not matched")
+	}
+	if binary.BigEndian.Uint16(out[4:6]) != 0x1234 || binary.BigEndian.Uint16(out[6:8]) != 3 {
+		t.Fatalf("ident/seq %x/%d", out[4:6], out[6:8])
+	}
+	if !validV4Checksum(out) {
+		t.Fatal("bad checksum")
+	}
+	if src != tcpip.AddrFrom4(icmpTarget.As4()) || dst != icmpClient {
+		t.Fatalf("addresses %v -> %v", src, dst)
+	}
+	if len(d.pending) != 0 {
+		t.Fatal("pending kept")
+	}
+	if _, _, _, ok := d.translate(false, echoMessage(byte(header.ICMPv4EchoReply), 7, 3, "abc"), icmpTarget); ok {
+		t.Fatal("second reply matched")
+	}
+}
+
+func TestICMPDirectForeignReplyIgnored(t *testing.T) {
+	d := newTestDirect()
+	if _, _, _, ok := d.translate(false, echoMessage(byte(header.ICMPv4EchoReply), 8, 3, ""), icmpTarget); ok {
+		t.Fatal("foreign ident matched")
+	}
+	if _, _, _, ok := d.translate(false, echoMessage(byte(header.ICMPv4EchoReply), 7, 3, ""), icmpRouter); ok {
+		t.Fatal("foreign address matched")
+	}
+	if len(d.pending) != 1 {
+		t.Fatal("pending lost")
+	}
+}
+
+func TestICMPDirectTimeExceededQuotesTheClient(t *testing.T) {
+	d := newTestDirect()
+	inner := make([]byte, header.IPv4MinimumSize)
+	header.IPv4(inner).Encode(&header.IPv4Fields{
+		TotalLength: header.IPv4MinimumSize + 8,
+		TTL:         1,
+		Protocol:    uint8(header.ICMPv4ProtocolNumber),
+		SrcAddr:     tcpip.AddrFrom4([4]byte{192, 168, 1, 5}),
+		DstAddr:     tcpip.AddrFrom4(icmpTarget.As4()),
+	})
+	header.IPv4(inner).SetChecksum(^header.IPv4(inner).CalculateChecksum())
+	quotedEcho := echoMessage(byte(header.ICMPv4Echo), 7, 3, "")
+	message := append([]byte{byte(header.ICMPv4TimeExceeded), 0, 0, 0, 0, 0, 0, 0}, inner...)
+	message = append(message, quotedEcho...)
+	binary.BigEndian.PutUint16(message[2:4], ^checksum.Checksum(message, 0))
+
+	out, src, dst, ok := d.translate(false, message, icmpRouter)
+	if !ok {
+		t.Fatal("error not matched")
+	}
+	if src != tcpip.AddrFrom4(icmpRouter.As4()) || dst != icmpClient {
+		t.Fatalf("addresses %v -> %v", src, dst)
+	}
+	if !validV4Checksum(out) {
+		t.Fatal("bad outer checksum")
+	}
+	ip := header.IPv4(out[8:])
+	if ip.SourceAddress() != icmpClient || !ip.IsChecksumValid() {
+		t.Fatalf("quoted source %v, checksum valid %v", ip.SourceAddress(), ip.IsChecksumValid())
+	}
+	echo := out[8+header.IPv4MinimumSize:]
+	if binary.BigEndian.Uint16(echo[4:6]) != 0x1234 || binary.BigEndian.Uint16(echo[2:4]) != 0xbeef {
+		t.Fatalf("quoted echo %x", echo[:8])
+	}
+}
diff --git a/proxy/tun/icmp_direct_windows.go b/proxy/tun/icmp_direct_windows.go
new file mode 100644
index 0000000..25adcd9
--- /dev/null
+++ b/proxy/tun/icmp_direct_windows.go
@@ -0,0 +1,21 @@
+//go:build windows
+
+package tun
+
+import (
+	"encoding/binary"
+	stdnet "net"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// IP_UNICAST_IF takes the index in network byte order, IPV6_UNICAST_IF as is
+func bindICMPSocket(fd uintptr, v6 bool, iface *stdnet.Interface) error {
+	if v6 {
+		return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IPV6, IPV6_UNICAST_IF, iface.Index)
+	}
+	var index [4]byte
+	binary.BigEndian.PutUint32(index[:], uint32(iface.Index))
+	return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IP, IP_UNICAST_IF, *(*int)(unsafe.Pointer(&index[0])))
+}
