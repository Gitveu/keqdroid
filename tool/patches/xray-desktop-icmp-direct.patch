+func echoTTL(netProto tcpip.NetworkProtocolNumber, pkt *stack.PacketBuffer) uint8 {
+	nh := pkt.NetworkHeader().Slice()
+	if netProto == header.IPv4ProtocolNumber && len(nh) >= header.IPv4MinimumSize {
+		return header.IPv4(nh).TTL()
+	}
+	if netProto == header.IPv6ProtocolNumber && len(nh) >= header.IPv6MinimumSize {
+		return header.IPv6(nh).HopLimit()
+	}
+	return 64
