Echo requests from the desktop tun inbound go out as real ICMP, past the tunnel.

The gVisor stack answers every echo request itself (BuildLocalEchoReply), so
with the TUN up, ping and tracert showed about 1 ms and an answer for any
address, a dead one included. keqdroid ran desktop TUN on sing-box before the
move to xray, and its route sent ICMP to the direct outbound: ping measured
the real path past the VPN, and tracert listed the hops.

Now an echo request goes out through a raw ICMP socket bound to the interface
autoOutboundsInterface found (IP_UNICAST_IF on Windows, SO_BINDTODEVICE on
Linux), opened again when that interface changes, with the request's TTL. The
echo reply, and a Time Exceeded or Destination Unreachable quoting the
request, are written back into the TUN with the client's ident and address.
The ident sent out is one of our own, so the system's ping socket does not get
the real reply as well and print every answer twice.

Windows and Linux only, where the TUN process has the rights for a raw socket
(administrator, root). Without the socket, without autoOutboundsInterface, and
on every other platform, Android included, the stack answers locally as
upstream does.
diff --git a/proxy/tun/icmp_direct.go b/proxy/tun/icmp_direct.go
new file mode 100644
index 0000000..fe5e81c
--- /dev/null
+++ b/proxy/tun/icmp_direct.go
@@ -0,0 +1,335 @@
+//go:build windows || (linux && !android)
+
+package tun
+
+import (
+	"context"
+	"encoding/binary"
+	stdnet "net"
+	"net/netip"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+	tunicmp "github.com/xtls/xray-core/proxy/tun/icmp"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+// keqdroid patch, see tool/patches/xray-desktop-icmp-direct.patch: echo
+// requests from the TUN go out as real ICMP past the tunnel, on the interface
+// autoOutboundsInterface found, the way sing-box's direct route sent them.
+// Replies, and the errors routers send for them (traceroute), come back into
+// the TUN. Without a raw socket the stack answers locally, as upstream does.
+
+const icmpPendingTTL = 30 * time.Second
+
+type icmpPendingKey struct {
+	dst   netip.Addr
+	ident uint16
+	seq   uint16
+}
+
+type icmpPending struct {
+	src      tcpip.Address
+	ident    uint16
+	checksum uint16
+	at       time.Time
+}
+
+type icmpSocket struct {
+	sync.Mutex
+	conn    stdnet.PacketConn
+	p4      *ipv4.PacketConn
+	p6      *ipv6.PacketConn
+	ifIndex int
+}
+
+type icmpDirect struct {
+	stack *stackGVisor
+
+	mu      sync.Mutex
+	sockets [2]*icmpSocket
+	failed  [2]bool
+	pending map[icmpPendingKey]icmpPending
+	nextID  uint16
+	closed  bool
+}
+
+func newICMPDirect(stack *stackGVisor) *icmpDirect {
+	return &icmpDirect{stack: stack, pending: map[icmpPendingKey]icmpPending{}}
+}
+
+// forward reports whether the request is taken care of; false leaves it to
+// the local reply.
+func (d *icmpDirect) forward(netProto tcpip.NetworkProtocolNumber, request []byte, ttl uint8, src, dst tcpip.Address) bool {
+	if d == nil || updater == nil {
+		return false
+	}
+	iface := updater.Get()
+	if iface == nil {
+		return false
+	}
+	v6 := netProto == header.IPv6ProtocolNumber
+	dstAddr, ok := netip.AddrFromSlice(dst.AsSlice())
+	if !ok || len(request) < 8 {
+		return false
+	}
+	sock := d.socket(v6, iface)
+	if sock == nil {
+		return false
+	}
+
+	message := append([]byte(nil), request...)
+	ident := binary.BigEndian.Uint16(message[4:6])
+	seq := binary.BigEndian.Uint16(message[6:8])
+	now := time.Now()
+
+	d.mu.Lock()
+	d.sweepLocked(now)
+	d.nextID++
+	id := d.nextID
+	key := icmpPendingKey{dst: dstAddr, ident: id, seq: seq}
+	d.pending[key] = icmpPending{
+		src:      src,
+		ident:    ident,
+		checksum: binary.BigEndian.Uint16(message[2:4]),
+		at:       now,
+	}
+	d.mu.Unlock()
+
+	// an ident of our own: the system's ping socket would also take the real
+	// reply for its ident, and ping would print every answer twice
+	binary.BigEndian.PutUint16(message[4:6], id)
+	if v6 {
+		// the kernel fills the ICMPv6 checksum of a raw socket, it needs the source address
+		binary.BigEndian.PutUint16(message[2:4], 0)
+	} else if err := tunicmp.RewriteChecksum(netProto, message, src, dst); err != nil {
+		d.drop(key)
+		return false
+	}
+
+	sock.Lock()
+	var err error
+	if v6 {
+		err = sock.p6.SetHopLimit(int(ttl))
+	} else {
+		err = sock.p4.SetTTL(int(ttl))
+	}
+	if err == nil {
+		_, err = sock.conn.WriteTo(message, &stdnet.IPAddr{IP: dstAddr.AsSlice()})
+	}
+	sock.Unlock()
+	if err != nil {
+		// as if the network lost it: the client times out
+		errors.LogDebugInner(d.stack.ctx, err, "[tun][icmp] failed to send echo request to ", dstAddr)
+		d.drop(key)
+	}
+	return true
+}
+
+func (d *icmpDirect) drop(key icmpPendingKey) {
+	d.mu.Lock()
+	delete(d.pending, key)
+	d.mu.Unlock()
+}
+
+func (d *icmpDirect) sweepLocked(now time.Time) {
+	if len(d.pending) < 1024 {
+		return
+	}
+	for key, p := range d.pending {
+		if now.Sub(p.at) > icmpPendingTTL {
+			delete(d.pending, key)
+		}
+	}
+}
+
+// socket opens a raw ICMP socket bound to iface, and opens it again when the
+// outbound interface changes, as the binding is made once at creation
+func (d *icmpDirect) socket(v6 bool, iface *stdnet.Interface) *icmpSocket {
+	i := 0
+	if v6 {
+		i = 1
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed || d.failed[i] {
+		return nil
+	}
+	if s := d.sockets[i]; s != nil {
+		if s.ifIndex == iface.Index {
+			return s
+		}
+		s.conn.Close()
+		d.sockets[i] = nil
+	}
+
+	network := "ip4:icmp"
+	if v6 {
+		network = "ip6:ipv6-icmp"
+	}
+	lc := stdnet.ListenConfig{Control: func(_, _ string, c syscall.RawConn) error {
+		var bindErr error
+		if err := c.Control(func(fd uintptr) {
+			bindErr = bindICMPSocket(fd, v6, iface)
+		}); err != nil {
+			return err
+		}
+		return bindErr
+	}}
+	conn, err := lc.ListenPacket(context.Background(), network, "")
+	if err != nil {
+		// no rights for a raw socket: stays local for the whole session
+		d.failed[i] = true
+		errors.LogInfoInner(d.stack.ctx, err, "[tun][icmp] no raw ", network, " socket, echo is answered locally")
+		return nil
+	}
+	s := &icmpSocket{conn: conn, ifIndex: iface.Index}
+	if v6 {
+		s.p6 = ipv6.NewPacketConn(conn)
+	} else {
+		s.p4 = ipv4.NewPacketConn(conn)
+	}
+	d.sockets[i] = s
+	go d.read(s, v6)
+	return s
+}
+
+func (d *icmpDirect) read(s *icmpSocket, v6 bool) {
+	buf := make([]byte, 65535)
+	for {
+		n, peer, err := s.conn.ReadFrom(buf)
+		if err != nil {
+			return
+		}
+		ipAddr, ok := peer.(*stdnet.IPAddr)
+		if !ok {
+			continue
+		}
+		from, ok := netip.AddrFromSlice(ipAddr.IP)
+		if !ok {
+			continue
+		}
+		d.handle(v6, append([]byte(nil), buf[:n]...), from.Unmap())
+	}
+}
+
+func (d *icmpDirect) handle(v6 bool, message []byte, from netip.Addr) {
+	reply, src, dst, ok := d.translate(v6, message, from)
+	if !ok {
+		return
+	}
+	netProto := header.IPv4ProtocolNumber
+	if v6 {
+		netProto = header.IPv6ProtocolNumber
+	}
+	if err := d.stack.writeRawICMPPacket(netProto, reply, src, dst); err != nil {
+		errors.LogDebugInner(d.stack.ctx, err, "[tun][icmp] failed to write a reply into the TUN")
+	}
+}
+
+// translate turns a message from the network into the one for the TUN client:
+// the client's ident back in an echo reply, and in an error, the client's
+// address and ident in the quoted request
+func (d *icmpDirect) translate(v6 bool, message []byte, from netip.Addr) ([]byte, tcpip.Address, tcpip.Address, bool) {
+	if len(message) < 8 {
+		return nil, tcpip.Address{}, tcpip.Address{}, false
+	}
+	netProto := header.IPv4ProtocolNumber
+	echoReply, echoRequest := byte(header.ICMPv4EchoReply), byte(header.ICMPv4Echo)
+	isError := message[0] == byte(header.ICMPv4TimeExceeded) || message[0] == byte(header.ICMPv4DstUnreachable)
+	if v6 {
+		netProto = header.IPv6ProtocolNumber
+		echoReply, echoRequest = byte(header.ICMPv6EchoReply), byte(header.ICMPv6EchoRequest)
+		isError = message[0] == byte(header.ICMPv6TimeExceeded) || message[0] == byte(header.ICMPv6DstUnreachable)
+	}
+	router := tcpip.AddrFromSlice(from.AsSlice())
+
+	switch {
+	case message[0] == echoReply && message[1] == 0:
+		key := icmpPendingKey{dst: from, ident: binary.BigEndian.Uint16(message[4:6]), seq: binary.BigEndian.Uint16(message[6:8])}
+		p, ok := d.take(key)
+		if !ok {
+			return nil, tcpip.Address{}, tcpip.Address{}, false
+		}
+		binary.BigEndian.PutUint16(message[4:6], p.ident)
+		if tunicmp.RewriteChecksum(netProto, message, router, p.src) != nil {
+			return nil, tcpip.Address{}, tcpip.Address{}, false
+		}
+		return message, router, p.src, true
+
+	case isError:
+		quoted := message[8:]
+		var ipLen int
+		var inner netip.Addr
+		if v6 {
+			if len(quoted) < header.IPv6MinimumSize+8 || header.IPv6(quoted).TransportProtocol() != header.ICMPv6ProtocolNumber {
+				return nil, tcpip.Address{}, tcpip.Address{}, false
+			}
+			ipLen = header.IPv6MinimumSize
+			innerDst := header.IPv6(quoted).DestinationAddress()
+			inner, _ = netip.AddrFromSlice(innerDst.AsSlice())
+		} else {
+			if len(quoted) < header.IPv4MinimumSize || quoted[0]>>4 != 4 {
+				return nil, tcpip.Address{}, tcpip.Address{}, false
+			}
+			ipLen = int(quoted[0]&0x0f) * 4
+			if ipLen < header.IPv4MinimumSize || len(quoted) < ipLen+8 || header.IPv4(quoted).Protocol() != uint8(header.ICMPv4ProtocolNumber) {
+				return nil, tcpip.Address{}, tcpip.Address{}, false
+			}
+			innerDst := header.IPv4(quoted).DestinationAddress()
+			inner, _ = netip.AddrFromSlice(innerDst.AsSlice())
+		}
+		echo := quoted[ipLen:]
+		if echo[0] != echoRequest {
+			return nil, tcpip.Address{}, tcpip.Address{}, false
+		}
+		key := icmpPendingKey{dst: inner, ident: binary.BigEndian.Uint16(echo[4:6]), seq: binary.BigEndian.Uint16(echo[6:8])}
+		p, ok := d.take(key)
+		if !ok {
+			return nil, tcpip.Address{}, tcpip.Address{}, false
+		}
+		if v6 {
+			header.IPv6(quoted).SetSourceAddress(p.src)
+		} else {
+			ip := header.IPv4(quoted)
+			ip.SetSourceAddressWithChecksumUpdate(p.src)
+		}
+		binary.BigEndian.PutUint16(echo[2:4], p.checksum)
+		binary.BigEndian.PutUint16(echo[4:6], p.ident)
+		if tunicmp.RewriteChecksum(netProto, message, router, p.src) != nil {
+			return nil, tcpip.Address{}, tcpip.Address{}, false
+		}
+		return message, router, p.src, true
+	}
+	return nil, tcpip.Address{}, tcpip.Address{}, false
+}
+
+func (d *icmpDirect) take(key icmpPendingKey) (icmpPending, bool) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	p, ok := d.pending[key]
+	if ok {
+		delete(d.pending, key)
+	}
+	return p, ok
+}
+
+func (d *icmpDirect) close() {
+	if d == nil {
+		return
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	d.closed = true
+	for i, s := range d.sockets {
+		if s != nil {
+			s.conn.Close()
+			d.sockets[i] = nil
+		}
+	}
+}
