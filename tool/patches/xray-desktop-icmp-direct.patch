+//go:build linux && !android
+
+package tun
+
+import (
+	stdnet "net"
+
+	"golang.org/x/sys/unix"
+)
+
+// the device binding also keeps the replies it writes into the TUN off the socket
+func bindICMPSocket(fd uintptr, _ bool, iface *stdnet.Interface) error {
+	return unix.BindToDevice(int(fd), iface.Name)
+}
