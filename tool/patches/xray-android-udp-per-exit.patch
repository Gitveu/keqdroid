+package tun
+
+import (
+	"sync"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/features/routing"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+// keqdroid: an outbound with this tag turns the per-exit flows of
+// udp_fullcone.go on. Off by default: P2P traffic that learns its address from
+// a STUN server on one exit and reaches the peer through another no longer
+// gets through directly. keqdroid adds the outbound (a blackhole nothing
+// routes to) when its setting is on.
+const udpPerExitTag = "keq-udp-per-exit"
+
+// The outbound the rules pick for one datagram, asked once per source and
+// destination: a process rule costs a lookup in the app.
+type udpExits struct {
+	sync.Mutex
+	m map[string]string
+}
+
+// a socket spraying addresses (DHT) would grow it forever
+const udpExitCache = 4096
+
+// nil without the mark, and the flows stay keyed by source as upstream
+func (t *Handler) udpExitFunc() func(src net.Destination, dst net.Destination) string {
+	if t.instance == nil {
+		return nil
+	}
+	m, ok := t.instance.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	if !ok || m.GetHandler(udpPerExitTag) == nil {
+		return nil
+	}
+	return t.udpExit
+}
+
+func (t *Handler) udpExit(src net.Destination, dst net.Destination) string {
+	pair := src.NetAddr() + ">" + dst.NetAddr()
+	t.exits.Lock()
+	exit, ok := t.exits.m[pair]
+	t.exits.Unlock()
+	if ok {
+		return exit
+	}
+	exit = t.pickExit(src, dst)
+	t.exits.Lock()
+	if t.exits.m == nil || len(t.exits.m) >= udpExitCache {
+		t.exits.m = make(map[string]string)
+	}
+	t.exits.m[pair] = exit
+	t.exits.Unlock()
+	return exit
+}
+
+// no matching rule is the default outbound, which is also where the catch-all
+// sends it: one key for both, or the same exit would be split in two
+func (t *Handler) pickExit(src net.Destination, dst net.Destination) string {
+	fallback := ""
+	if m, ok := t.instance.GetFeature(outbound.ManagerType()).(outbound.Manager); ok {
+		if h := m.GetDefaultHandler(); h != nil {
+			fallback = h.Tag()
+		}
+	}
+	router, ok := t.instance.GetFeature(routing.RouterType()).(routing.Router)
+	if !ok || router == nil {
+		return fallback
+	}
+	ctx := session.ContextWithInbound(t.ctx, &session.Inbound{
+		Name:   "tun",
+		Tag:    t.tag,
+		Source: src,
+	})
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{
+		Target:         dst,
+		OriginalTarget: dst,
+	}})
+	route, err := router.PickRoute(routing_session.AsRoutingContext(ctx))
+	if err != nil {
+		return fallback
+	}
+	if tag := route.GetOutboundTag(); tag != "" {
+		return tag
+	}
+	return fallback
+}
