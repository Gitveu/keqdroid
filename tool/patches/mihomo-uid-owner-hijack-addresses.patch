diff --git a/component/resolver/relay_addresses_only_test.go b/component/resolver/relay_addresses_only_test.go
new file mode 100644
--- /dev/null
+++ b/component/resolver/relay_addresses_only_test.go
@@ -0,0 +1,54 @@
+package resolver
+
+import (
+	"context"
+	"testing"
+
+	D "github.com/miekg/dns"
+)
+
+// keqdroid: queries the app could not tie to an owner get addresses only,
+// see tool/patches/mihomo-uid-owner-hijack-addresses.patch
+func TestRelayAddressesOnly(t *testing.T) {
+	ask := func(name string, qtype, qclass uint16) []byte {
+		m := new(D.Msg)
+		m.SetQuestion(D.Fqdn(name), qtype)
+		m.Question[0].Qclass = qclass
+		b, err := m.Pack()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return b
+	}
+	rcode := func(ctx context.Context, q []byte) int {
+		out, err := relayDnsPacket(ctx, q, make([]byte, SafeDnsPacketSize), SafeDnsPacketSize)
+		if err != nil {
+			t.Fatal(err)
+		}
+		m := new(D.Msg)
+		if err := m.Unpack(out); err != nil {
+			t.Fatal(err)
+		}
+		return m.Rcode
+	}
+	only := WithAddressesOnly(context.Background())
+
+	for _, q := range [][]byte{
+		ask("whoami.cloudflare", D.TypeTXT, D.ClassCHAOS),
+		ask("o-o.myaddr.l.google.com", D.TypeTXT, D.ClassINET),
+		ask("example.com", D.TypeHTTPS, D.ClassINET),
+	} {
+		if got := rcode(only, q); got != D.RcodeRefused {
+			t.Errorf("addresses only: want REFUSED, got %s", D.RcodeToString[got])
+		}
+		// no resolver in the test: past the gate a query fails with SERVFAIL
+		if got := rcode(context.Background(), q); got == D.RcodeRefused {
+			t.Error("without the flag the gate must not refuse")
+		}
+	}
+	for _, qtype := range []uint16{D.TypeA, D.TypeAAAA} {
+		if got := rcode(only, ask("example.com", qtype, D.ClassINET)); got == D.RcodeRefused {
+			t.Errorf("%s must pass the gate", D.TypeToString[qtype])
+		}
+	}
+}
