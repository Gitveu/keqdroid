+type addressesOnlyKey struct{}
+
+// WithAddressesOnly makes the relay answer only A and AAAA questions and
+// refuse the rest, as xray's dns outbound does. keqdroid, see
+// tool/patches/mihomo-uid-owner-hijack-addresses.patch.
+func WithAddressesOnly(ctx context.Context) context.Context {
+	return context.WithValue(ctx, addressesOnlyKey{}, true)
+}
+
+func asksAddressOnly(msg *D.Msg) bool {
+	if len(msg.Question) != 1 || msg.Question[0].Qclass != D.ClassINET {
+		return false
+	}
+	qtype := msg.Question[0].Qtype
+	return qtype == D.TypeA || qtype == D.TypeAAAA
+}
+
