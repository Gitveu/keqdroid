+
+// keqdroid: with only selected apps in the VPN the system's own DNS arrives
+// with no owner the VPN may see, and the app answers empty for it so the
+// guard lets it through. An app outside the VPN can send its query to the
+// same address, so such queries get addresses only: "whoami.cloudflare TXT
+// CH" relayed through the server came back with the server address.
+func dnsWithoutOwner(network string, metadata M.Metadata) bool {
+	if ownerSocket == "" || ownerGuardMode() == "" {
+		return false
+	}
+	pkg, err := askOwnerOf(network, metadata.Source.AddrPort(), metadata.Destination.AddrPort())
+	return err == nil && pkg == ""
+}
