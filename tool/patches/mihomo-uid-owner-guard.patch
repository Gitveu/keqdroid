diff --git a/listener/sing_tun/owner_guard.go b/listener/sing_tun/owner_guard.go
new file mode 100644
index 0000000..90af972
--- /dev/null
+++ b/listener/sing_tun/owner_guard.go
@@ -0,0 +1,19 @@
+package sing_tun
+
+import "sync/atomic"
+
+// keqdroid: the app answers this for a connection the system says is not
+// the VPN's own, an app outside the VPN that bound its socket to the tun.
+const outsideVPNOwner = "keqdroid:outside-vpn"
+
+// keqdroid-owner-guard in the config. Empty: that answer counts as an unknown
+// owner, as before the guard. "connections": it becomes the process name, and
+// keqdroid's first rule rejects it. "all": the DNS hijack checks it too.
+var ownerGuard atomic.Value
+
+func SetOwnerGuard(mode string) { ownerGuard.Store(mode) }
+
+func ownerGuardMode() string {
+	mode, _ := ownerGuard.Load().(string)
+	return mode
+}
