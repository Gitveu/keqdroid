+// keqdroid, keqdroid-udp-per-exit in the config: the NAT table was keyed by the
+// source socket alone, so a socket went out through whatever its first
+// datagram matched, and an address routed to another proxy later on rode
+// along. Keyed by socket and exit, a socket that stays on one exit keeps one
+// session (one external port for P2P), and an address that the rules send
+// elsewhere gets its own. Off by default: P2P whose peer and STUN server the
+// rules send to different exits no longer gets through directly.
+var udpPerExit atomic.Bool
+
+var udpExits = struct {
+	sync.Mutex
+	m map[string]string
+}{m: map[string]string{}}
+
+func SetUDPPerExit(on bool) {
+	udpPerExit.Store(on)
+	udpExits.Lock()
+	udpExits.m = map[string]string{}
+	udpExits.Unlock()
+}
+
+func udpExitKey(key string, metadata *C.Metadata) string {
+	pair := key + ">" + metadata.RemoteAddress()
+	udpExits.Lock()
+	exit, ok := udpExits.m[pair]
+	udpExits.Unlock()
+	if !ok {
+		m := metadata.Clone()
+		if err := preHandleMetadata(m); err != nil {
+			return key
+		}
+		proxy, _, err := resolveMetadata(m)
+		if err != nil {
+			return key
+		}
+		exit = proxy.Name()
+		udpExits.Lock()
+		// a socket spraying addresses (DHT) would grow it forever
+		if len(udpExits.m) >= 65536 {
+			udpExits.m = map[string]string{}
+		}
+		udpExits.m[pair] = exit
+		udpExits.Unlock()
+	}
+	return key + "|" + exit
+}
