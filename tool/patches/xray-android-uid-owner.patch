+//go:build android
+
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	xnet "github.com/xtls/xray-core/common/net"
+)
+
+// keqdroid: the app that owns the VPN answers on this abstract socket, see
+// the patch header.
+var ownerSocket = os.Getenv("KEQDROID_OWNER_SOCKET")
+
+func init() {
+	if ownerSocket != "" {
+		xnet.RegisterAndroidProcessFinder(findOwner)
+	}
+}
+
+type ownerAnswer struct {
+	pkg string
+	at  time.Time
+}
+
+// The router asks again for every rule with a process condition, so one
+// connection walking past several app routes would pay a round trip each.
+const ownerTTL = 2 * time.Second
+
+var (
+	ownerMu    sync.Mutex
+	ownerCache = map[string]ownerAnswer{}
+)
+
+func findOwner(network, srcIP string, srcPort uint16, dstIP string, dstPort uint16) (int, string, string, error) {
+	if dstIP == "" {
+		return 0, "", "", xnet.ErrNotLocal
+	}
+	key := fmt.Sprintf("%s %s %d %s %d", network, srcIP, srcPort, dstIP, dstPort)
+	now := time.Now()
+	ownerMu.Lock()
+	cached, ok := ownerCache[key]
+	ownerMu.Unlock()
+	if ok && now.Sub(cached.at) < ownerTTL {
+		return ownerResult(cached.pkg)
+	}
+	pkg, err := askOwner(key)
+	if err != nil {
+		return 0, "", "", err
+	}
+	ownerMu.Lock()
+	if len(ownerCache) >= 1024 {
+		for k, a := range ownerCache {
+			if now.Sub(a.at) >= ownerTTL {
+				delete(ownerCache, k)
+			}
+		}
+	}
+	ownerCache[key] = ownerAnswer{pkg: pkg, at: now}
+	ownerMu.Unlock()
+	return ownerResult(pkg)
+}
+
+// An unknown owner is ErrNotLocal: the router drops that one silently instead
+// of logging an error for every connection of a system process.
+func ownerResult(pkg string) (int, string, string, error) {
+	if pkg == "" {
+		return 0, "", "", xnet.ErrNotLocal
+	}
+	return 0, pkg, "", nil
+}
+
+func askOwner(request string) (string, error) {
+	conn, err := net.DialTimeout("unix", "@"+ownerSocket, time.Second)
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(time.Second))
+	if _, err := fmt.Fprintf(conn, "%s\n", request); err != nil {
+		return "", err
+	}
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if err != nil {
+		return "", err
+	}
+	return strings.TrimSpace(line), nil
+}
