+// originalTargetIP is the address the connection was opened to, before
+// sniffing replaced the target with a domain. keqdroid patch, see
+// tool/patches/xray-android-uid-owner.patch.
+func originalTargetIP(ctx routing.Context) (string, uint16, bool) {
+	if resolvable, ok := ctx.(*dns.ResolvableContext); ok {
+		ctx = resolvable.Context
+	}
+	sctx, ok := ctx.(*routing_session.Context)
+	if !ok || sctx.Outbound == nil {
+		return "", 0, false
+	}
+	target := sctx.Outbound.OriginalTarget
+	if target.Address == nil || !target.Address.Family().IsIP() {
+		return "", 0, false
+	}
+	return target.Address.IP().String(), uint16(target.Port), true
+}
