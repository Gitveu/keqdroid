diff --git a/app/router/condition_process_test.go b/app/router/condition_process_test.go
new file mode 100644
index 0000000..c831f7b
--- /dev/null
+++ b/app/router/condition_process_test.go
@@ -0,0 +1,94 @@
+//go:build windows || linux
+
+package router_test
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+// keqdroid patch, see tool/patches/xray-desktop-process.patch. The test opens a
+// TCP connection to itself, so the system tables name this test binary.
+func selfConnContext(t *testing.T) *routing_session.Context {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { l.Close() })
+	go func() {
+		if c, err := l.Accept(); err == nil {
+			t.Cleanup(func() { c.Close() })
+		}
+	}()
+	c, err := net.Dial("tcp", l.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { c.Close() })
+	return &routing_session.Context{
+		Inbound: &session.Inbound{Source: net.DestinationFromAddr(c.LocalAddr())},
+		Outbound: &session.Outbound{
+			Target: net.DestinationFromAddr(c.RemoteAddr()),
+		},
+	}
+}
+
+func selfName(t *testing.T) string {
+	t.Helper()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return strings.TrimSuffix(filepath.Base(exe), ".exe")
+}
+
+func TestProcessNegation(t *testing.T) {
+	ctx := selfConnContext(t)
+	self := selfName(t)
+
+	if NewProcessNameMatcher([]string{"!" + self}).Apply(ctx) {
+		t.Fatal("!self matched the process it excludes")
+	}
+	if !NewProcessNameMatcher([]string{"!no-such-program"}).Apply(ctx) {
+		t.Fatal("!other did not match a process outside the list")
+	}
+	if !NewProcessNameMatcher([]string{self}).Apply(ctx) {
+		t.Fatal("the plain name stopped matching")
+	}
+}
+
+func TestProcessUnknownIsOutside(t *testing.T) {
+	ctx := &routing_session.Context{
+		Inbound:  &session.Inbound{Source: net.TCPDestination(net.ParseAddress("127.0.0.1"), 1)},
+		Outbound: &session.Outbound{Target: net.TCPDestination(net.ParseAddress("127.0.0.1"), 2)},
+	}
+	if !NewProcessNameMatcher([]string{"!anything"}).Apply(ctx) {
+		t.Fatal("a process the tables do not know must count as outside the list")
+	}
+	if NewProcessNameMatcher([]string{"anything"}).Apply(ctx) {
+		t.Fatal("an unknown process matched a name")
+	}
+}
+
+func TestProcessCaseOnWindows(t *testing.T) {
+	if runtime.GOOS != "windows" {
+		t.Skip("names keep their case outside Windows")
+	}
+	ctx := selfConnContext(t)
+	if !NewProcessNameMatcher([]string{strings.ToUpper(selfName(t)) + ".EXE"}).Apply(ctx) {
+		t.Fatal("the name in another case did not match")
+	}
+	exe, _ := os.Executable()
+	if !NewProcessNameMatcher([]string{strings.ToUpper(filepath.ToSlash(exe))}).Apply(ctx) {
+		t.Fatal("the path in another case did not match")
+	}
+}
