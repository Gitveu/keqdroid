+// FindProcess on Windows cuts only a lowercase ".exe", and Office ships
+// WINWORD.EXE and OUTLOOK.EXE: rule names and found names go through here
+func trimExe(name string) string {
+	if runtime.GOOS == "windows" && len(name) > 4 && strings.EqualFold(name[len(name)-4:], ".exe") {
+		return name[:len(name)-4]
+	}
+	return strings.TrimSuffix(name, ".exe")
