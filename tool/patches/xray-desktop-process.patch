diff --git a/common/net/find_process_cached.go b/common/net/find_process_cached.go
new file mode 100644
index 0000000..9ad0d82
--- /dev/null
+++ b/common/net/find_process_cached.go
@@ -0,0 +1,61 @@
+package net
+
+import (
+	"runtime"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// keqdroid patch, see tool/patches/xray-desktop-process.patch. Every process
+// rule of a connection used to search the system tables again, and so did the
+// access log: one search per connection now, kept for a moment.
+
+const processCacheTTL = 2 * time.Second
+
+type processResult struct {
+	pid     int
+	name    string
+	absPath string
+	err     error
+	until   time.Time
+}
+
+var processCache = struct {
+	sync.Mutex
+	entries map[string]processResult
+}{entries: map[string]processResult{}}
+
+func FindProcessCached(network, srcIP string, srcPort uint16, destIP string, destPort uint16) (int, string, string, error) {
+	// Android asks the app, which keeps its own answers by both ends and never
+	// keeps a failed one (xray-android-uid-owner.patch)
+	if runtime.GOOS == "android" {
+		return FindProcess(network, srcIP, srcPort, destIP, destPort)
+	}
+	key := network + "|" + srcIP + "|" + strconv.Itoa(int(srcPort))
+	now := time.Now()
+
+	processCache.Lock()
+	if hit, ok := processCache.entries[key]; ok && now.Before(hit.until) {
+		processCache.Unlock()
+		return hit.pid, hit.name, hit.absPath, hit.err
+	}
+	processCache.Unlock()
+
+	pid, name, absPath, err := FindProcess(network, srcIP, srcPort, destIP, destPort)
+
+	processCache.Lock()
+	if len(processCache.entries) >= 4096 {
+		for k, v := range processCache.entries {
+			if !now.Before(v.until) {
+				delete(processCache.entries, k)
+			}
+		}
+		if len(processCache.entries) >= 16384 {
+			processCache.entries = map[string]processResult{}
+		}
+	}
+	processCache.entries[key] = processResult{pid, name, absPath, err, now.Add(processCacheTTL)}
+	processCache.Unlock()
+	return pid, name, absPath, err
+}
