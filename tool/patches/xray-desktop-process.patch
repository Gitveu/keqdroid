@@ -0,0 +1,27 @@
+package router
+
+import (
+	"runtime"
+	"testing"
+)
+
+// keqdroid patch, see tool/patches/xray-desktop-process.patch
+func TestTrimExe(t *testing.T) {
+	cases := map[string]string{
+		"curl.exe":  "curl",
+		"curl":      "curl",
+		"a.exe.exe": "a.exe",
+		".exe":      "",
+	}
+	if runtime.GOOS == "windows" {
+		cases["WINWORD.EXE"] = "WINWORD"
+		cases["Outlook.Exe"] = "Outlook"
+	} else {
+		cases["WINWORD.EXE"] = "WINWORD.EXE"
+	}
+	for in, want := range cases {
+		if got := trimExe(in); got != want {
+			t.Errorf("trimExe(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
