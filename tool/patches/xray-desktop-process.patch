+package dispatcher
+
+import (
+	"context"
+	"runtime"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+)
+
+// processLogTag names an outbound, routed to by nothing, whose presence makes
+// the access log name the programs of local SOCKS and HTTP clients too
+const processLogTag = "keq-process-log"
+
+// keqdroid patch, see tool/patches/xray-desktop-process.patch: the access log
+// names the program of a connection, from the same cached lookup the process
+// rules use. TUN connections always, as sing-box's find_process did there;
+// local SOCKS and HTTP clients only with the processLogTag outbound, as sing-box
+// did only in debug mode. On Android the app asks the VPN service instead.
+func (d *DefaultDispatcher) connProcess(ctx context.Context, ob *session.Outbound, destination net.Destination) string {
+	if runtime.GOOS == "android" {
+		return ""
+	}
+	inbound := session.InboundFromContext(ctx)
+	if inbound == nil || inbound.Source.Address == nil || !inbound.Source.Address.Family().IsIP() {
+		return ""
+	}
+	switch inbound.Name {
+	case "tun":
+	case "socks", "http":
+		if !inbound.Source.Address.IP().IsLoopback() || d.ohm.GetHandler(processLogTag) == nil {
+			return ""
+		}
+	default:
+		return ""
+	}
+	target := ob.OriginalTarget
+	if target.Address == nil || !target.Address.Family().IsIP() {
+		target = destination
+	}
+	dstIP := ""
+	if target.Address != nil && target.Address.Family().IsIP() {
+		dstIP = target.Address.IP().String()
+	}
+	network := "tcp"
+	if destination.Network == net.Network_UDP {
+		network = "udp"
+	}
+	_, _, path, err := net.FindProcessCached(network, inbound.Source.Address.IP().String(),
+		uint16(inbound.Source.Port), dstIP, uint16(target.Port))
+	if err != nil {
+		return ""
+	}
+	return path
+}
