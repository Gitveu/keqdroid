{
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "address": "198.51.100.32",
        "port": 443,
        "id": "00000000-0000-4000-8000-000000000000",
        "encryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls"
      }
    },
    {
      "protocol": "blackhole",
      "tag": "keq-block"
    },
    {
      "protocol": "freedom",
      "tag": "keq-direct"
    },
    {
      "protocol": "dns",
      "tag": "keq-dns-out",
      "settings": {
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "return",
            "rCode": 5
          }
        ]
      }
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "port": 0,
      "protocol": "tun",
      "settings": {
        "name": "tun-keqdis",
        "mtu": 9000,
        "gateway": [
          "172.19.0.1/30"
        ],
        "dns": [
          "172.19.0.2"
        ],
        "autoSystemRoutingTable": [
          "0.0.0.0/0"
        ],
        "autoOutboundsInterface": "auto"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "socks-in",
      "port": 2080,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "udp": true,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "http-in",
      "port": 2081,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "address": "localhost",
        "domains": [
          "domain:direct.example"
        ],
        "skipFallback": true,
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "localhost",
        "timeoutMs": 2500,
        "serveStale": true
      }
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "rules": [
      {
        "type": "field",
        "ruleTag": "tun-dns",
        "inboundTag": [
          "tun-in"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "tun-own",
        "inboundTag": [
          "tun-in"
        ],
        "process": [
          "keqdroid.exe",
          "xray",
          "mihomo"
        ],
        "outboundTag": "keq-direct"
      },
      {
        "type": "field",
        "ruleTag": "tun-excluded",
        "inboundTag": [
          "tun-in"
        ],
        "process": [
          "steam.exe"
        ],
        "outboundTag": "keq-direct"
      },
      {
        "type": "field",
        "ruleTag": "dns-out-tun",
        "inboundTag": [
          "tun-in",
          "socks-in",
          "http-in"
        ],
        "ip": [
          "172.19.0.2/32"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "exit-ip-probe",
        "domain": [
          "full:www.cloudflare.com"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "dns-out",
        "inboundTag": [
          "tun-in",
          "socks-in",
          "http-in"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "user-block-domains",
        "domain": [
          "domain:ads.example",
          "geosite:category-ads-all"
        ],
        "outboundTag": "keq-block"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-domains",
        "domain": [
          "domain:direct.example"
        ],
        "outboundTag": "keq-direct"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-ips",
        "ip": [
          "10.10.0.0/16"
        ],
        "outboundTag": "keq-direct"
      },
      {
        "type": "field",
        "ruleTag": "user-proxy-domains",
        "domain": [
          "domain:proxy.example",
          "geosite:google"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "final",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}