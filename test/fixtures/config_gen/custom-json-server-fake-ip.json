{
  "dns": {
    "servers": [
      {
        "address": "https://common.dot.dns.yandex.net/dns-query",
        "domains": [
          "domain:ru"
        ],
        "skipFallback": true
      },
      {
        "address": "1.1.1.1",
        "domains": [
          "domain:lan",
          "domain:local",
          "domain:localdomain",
          "domain:home.arpa",
          "full:localhost",
          "full:connectivitycheck.gstatic.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com",
          "full:captive.apple.com",
          "regexp:^time\\.[^.]+\\.com$",
          "domain:ntp.org"
        ],
        "skipFallback": true
      },
      {
        "address": "fakedns"
      },
      "1.1.1.1",
      {
        "address": "https://1.1.1.1/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "timeoutMs": 2500,
        "serveStale": true
      },
      {
        "address": "localhost",
        "timeoutMs": 2500,
        "serveStale": true
      }
    ]
  },
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "protocol": "blackhole",
      "tag": "keq-block"
    },
    {
      "protocol": "dns",
      "tag": "keq-dns-out",
      "settings": {
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "return",
            "rCode": 5
          }
        ]
      }
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "port": 0,
      "protocol": "tun",
      "settings": {
        "name": "keqtun0",
        "mtu": 1400
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "socks-in",
      "port": 2080,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "udp": true,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "http-in",
      "port": 2081,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false,
        "accounts": [
          {
            "user": "u",
            "pass": "p"
          }
        ]
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "ruleTag": "dns-out-tun",
        "inboundTag": [
          "tun-in",
          "socks-in",
          "http-in"
        ],
        "ip": [
          "172.19.0.2/32"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "exit-ip-probe",
        "domain": [
          "full:www.cloudflare.com"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "dns-out",
        "inboundTag": [
          "tun-in",
          "socks-in",
          "http-in"
        ],
        "port": "53",
        "network": "tcp,udp",
        "outboundTag": "keq-dns-out"
      },
      {
        "type": "field",
        "ruleTag": "user-block-domains",
        "domain": [
          "domain:ads.example",
          "geosite:category-ads-all"
        ],
        "outboundTag": "keq-block"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-domains",
        "domain": [
          "domain:direct.example"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "user-direct-ips",
        "ip": [
          "10.10.0.0/16"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "user-proxy-domains",
        "domain": [
          "domain:proxy.example",
          "geosite:google"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "ruleTag": "final",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/16",
      "poolSize": 65535
    }
  ]
}